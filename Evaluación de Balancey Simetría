      "source": [
        "def evaluar_balance(cargas, tolerancia):\n",
        "    n, m = len(cargas), len(cargas[0])\n",
        "    pesos_longitudinales = []\n",
        "    suma_izq = 0\n",
        "    suma_der = 0\n",
        "    mitad = m // 2\n",
        "\n",
        "    for i in range(n):\n",
        "        # Sumatoria de fila longitudinal\n",
        "        pesos_longitudinales.append(sum(cargas[i]))\n",
        "\n",
        "        # Separación lateral babor/estribor\n",
        "        suma_izq += sum(cargas[i][:mitad])\n",
        "\n",
        "        if m % 2 == 0:\n",
        "            suma_der += sum(cargas[i][mitad:])\n",
        "        else:\n",
        "            # Si M es impar, omitimos la columna central (mitad)\n",
        "            suma_der += sum(cargas[i][mitad+1:])\n",
        "\n",
        "    desbalance = abs(suma_izq - suma_der)\n",
        "    balance_aprobado = desbalance <= tolerancia\n",
        "\n",
        "    return pesos_longitudinales, desbalance, balance_aprobado"
      ]
    }
  ]
