        "def extraer_submatriz_critica(porcentajes, k, p):\n",
        "    n, m = len(porcentajes), len(porcentajes[0])\n",
        "    max_promedio = -1\n",
        "    mejor_submatriz = []\n",
        "\n",
        "    # Ventana deslizante para encontrar la submatriz\n",
        "    for i in range(n - k + 1):\n",
        "        for j in range(m - p + 1):\n",
        "            # Extraer sección k x p\n",
        "            sub = [fila[j:j+p] for fila in porcentajes[i:i+k]]\n",
        "\n",
        "            # Calcular promedio de esta sección\n",
        "            suma_total = sum(sum(fila) for fila in sub)\n",
        "            promedio = suma_total / (k * p)\n",
        "\n",
        "            # Guardar la que tenga mayor promedio\n",
        "            if promedio > max_promedio:\n",
        "                max_promedio = promedio\n",
        "                mejor_submatriz = sub\n",
        "\n",
        "    return mejor_submatriz"
      ]
    }
